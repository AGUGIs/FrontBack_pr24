# Конфигурация dev-сервера CRA.
# По умолчанию — HTTP: совпадает с docker compose (HTTP_ONLY=true) и
# с локальным запуском сервера без сертификатов.
#
# Если ты сгенерировал сертификаты (`cd server && npm run cert`) и хочешь HTTPS
# (как в ПР15), создай рядом файл `.env.development.local` со следующим содержимым:
#   HTTPS=true
#   SSL_CRT_FILE=../server/localhost.pem
#   SSL_KEY_FILE=../server/localhost-key.pem
#   REACT_APP_PROXY_TARGET=https://localhost:3000
# Файлы *.local не попадают в git и переопределяют этот файл.

HTTPS=false
REACT_APP_API_URL=/api
REACT_APP_SERVER_URL=
REACT_APP_PROXY_TARGET=http://localhost:3000
