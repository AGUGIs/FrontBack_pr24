# PostgreSQL (ПР19)
# При docker compose up postgres с хоста доступен на порту 5433 (см. docker-compose.yml).
# pgAdmin и локальный npm start сервера должны использовать один и тот же порт.
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=kastryula_market
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/kastryula_market
PG_ENABLED=true

# MongoDB (ПР20)
MONGO_URI=mongodb://localhost:27017/kastryula_market
MONGO_ENABLED=true

# Redis (ПР21)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Docker / HTTP без HTTPS
# HTTP_ONLY=true
